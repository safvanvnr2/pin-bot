# Copy to .env and fill in (see SETUP.md for where each value comes from)
WHATSAPP_VERIFY_TOKEN=pick-any-random-string-you-like
WHATSAPP_TOKEN=paste-your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id
WHATSAPP_APP_SECRET=paste-your-app-secret
# Optional: path to the pincode database (defaults to data/pincodes.db)
# PINCODE_DB=data/pincodes.db
# Optional: server port (defaults to 5000)
# PORT=5000
